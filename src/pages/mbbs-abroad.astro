<script>
  // Custom phone validation message
  const phoneInput = document.getElementById('phoneInput') as HTMLInputElement;
  if (phoneInput) {
    phoneInput.addEventListener('input', () => {
      if (phoneInput.validity.patternMismatch || phoneInput.validity.valueMissing) {
        phoneInput.setCustomValidity('Please enter a 10 digit number');
      } else {
        phoneInput.setCustomValidity('');
      }
    });
    phoneInput.addEventListener('invalid', () => {
      phoneInput.setCustomValidity('Please enter a 10 digit number');
    });
  }

  const WORKER_URL = 'https://api.konfido.co.in';

  document.getElementById('callbackForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitBtn.innerHTML;
    submitBtn.innerHTML = 'Sending...';
    submitBtn.disabled = true;

    const f = new FormData(form);
    const city = f.get('city');
    const msg = f.get('message');
    const universityText = `City: ${city || 'N/A'} | Message: ${msg || 'None'}`;

    const formData = {
      name: f.get('name'),
      email: f.get('email'),
      phone: f.get('phone'),
      course: 'Medical / Para-Medical',
      university: universityText.substring(0, 100), // Max length 100 for API
      source: window.location.href,
      submittedAt: new Date().toISOString()
    };

    try {
      const response = await fetch(WORKER_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-API-Key': import.meta.env.PUBLIC_API_KEY,
        },
        body: JSON.stringify(formData)
      });

      const result = await response.json();

      if (result.success) {
        form.style.display = 'none';
        const successMsg = document.getElementById('contactFormSuccess');
        if (successMsg) successMsg.style.display = 'block';

        if (typeof window !== 'undefined' && 'gtag' in window) {
          (window as any).gtag('event', 'contact_submit', {
            'event_category': 'lead',
            'event_label': 'MBBS Form'
          });
        }
        if (typeof window !== 'undefined' && 'fbq' in window) {
          (window as any).fbq('track', 'Lead');
        }
      } else {
        const errMsg = result.errors
          ? Object.values(result.errors).join('\n')
          : result.error || 'Submission failed';
        alert(errMsg);
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
      }
    } catch (error) {
      console.error('Contact form error:', error);
      alert('Something went wrong. Please try again or contact us directly at info@konfido.co.in');
      submitBtn.innerHTML = originalText;
      submitBtn.disabled = false;
    }
  });

  // Intersection Observer for fade-up animations
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.fade-up').forEach((el) => {
    observer.observe(el);
  });
</script>
