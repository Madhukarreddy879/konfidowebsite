---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout>
  <Navbar />
  
  <div class="uni-hero">
    <div class="container">
      <div class="uni-hero-content">
        <div class="uni-logo-box">
          <img src="/logos/marwadi.png" alt="Marwadi University" class="uni-logo" />
        </div>
        <div class="uni-hero-text">
          <div class="uni-badge">Centre of Excellence · Govt. of Gujarat</div>
          <h1 class="uni-title">Marwadi University</h1>
          <p class="uni-location">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Rajkot, Gujarat
          </p>
        </div>
      </div>
    </div>
  </div>

  <section class="section uni-content">
    <div class="container">
      
      <!-- Recognitions Bar (Fixed broken images) -->
      <div class="recognitions-bar">
        <div class="rec-item">
          <div class="rec-badge naac-badge">NAAC</div>
          <div>
            <span class="rec-title">Accredited</span>
            <strong class="rec-grade">A+ Grade</strong>
          </div>
        </div>
        <div class="rec-item">
          <div class="rec-badge nirf-badge">NIRF</div>
          <div>
            <span class="rec-title">Ranking 2025</span>
            <strong class="rec-grade">Top 150 Band</strong>
          </div>
        </div>
        <div class="rec-item">
           <div class="rec-badge nba-badge">NBA</div>
           <div>
            <span class="rec-title">Tier-1</span>
            <strong class="rec-grade">Accreditation</strong>
          </div>
        </div>
      </div>

      <div class="uni-grid">
        <!-- Left Column: About & Courses -->
        <div class="uni-main">
          
          <div class="content-block">
            <h2>About Marwadi University</h2>
            <p>
              Accredited with a prestigious <strong>NAAC A+ grade</strong> and recognized as a "Centre of Excellence" by the Government of Gujarat, Marwadi University is a premier institution dedicated to academic brilliance and holistic development.
            </p>
            <p>
              With Tier-1 NBA accreditation and a top 150 NIRF ranking, MU provides a state-of-the-art 32-acre campus where innovation thrives. It hosts over 500 top-tier companies annually, boasting exceptional placement records.
            </p>
          </div>
          
          <!-- Top Recruiters Grid instead of Marquee for better mobile/desktop rendering -->
          <div class="content-block">
            <h2>Top Recruiters</h2>
            <div class="recruiters-grid">
              <div class="recruiter-logo">Amazon</div>
              <div class="recruiter-logo">TCS</div>
              <div class="recruiter-logo">Infosys</div>
              <div class="recruiter-logo">Capgemini</div>
              <div class="recruiter-logo">IBM</div>
              <div class="recruiter-logo">Wipro</div>
            </div>
          </div>

          <div class="content-block">
            <h2>Programs Offered</h2>
            <div class="courses-grid">
              <div class="course-card">
                <div class="cc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div>
                <h3>Engineering & Tech</h3>
                <p>B.Tech, M.Tech (CS, AI, Mech, Civil)</p>
              </div>
              <div class="course-card">
                <div class="cc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
                <h3>Management</h3>
                <p>BBA, MBA, Business Analytics</p>
              </div>
              <div class="course-card">
                <div class="cc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></div>
                <h3>IT & Computer Apps</h3>
                <p>BCA, MCA, B.Sc IT</p>
              </div>
              <div class="course-card">
                <div class="cc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
                <h3>Law & Sciences</h3>
                <p>BA LLB, B.Pharma, B.Sc/M.Sc</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Stats & Form -->
        <div class="uni-sidebar">
          
          <div class="stats-box placement-box">
            <div class="pb-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <h4>Highest Placement</h4>
            <div class="pb-amount">₹34.5 <span>LPA</span></div>
            <p>Average Package: ₹5-6 LPA</p>
          </div>

          <div class="stats-box">
            <h3>Quick Facts</h3>
            <ul class="stats-list">
              <li>
                <span class="stat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg></span>
                <div>
                  <span class="stat-label">Campus Area</span>
                  <strong class="stat-value">32+ Acres</strong>
                </div>
              </li>
              <li>
                <span class="stat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
                <div>
                  <span class="stat-label">Placement Rate</span>
                  <strong class="stat-value">90%+</strong>
                </div>
              </li>
              <li>
                <span class="stat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/></svg></span>
                <div>
                  <span class="stat-label">Recruiting Companies</span>
                  <strong class="stat-value">500+ Annually</strong>
                </div>
              </li>
            </ul>
          </div>

          <div class="apply-box">
            <div class="apply-header">
              <h3>Secure Your Admission</h3>
              <p>Get priority guidance from Konfido's expert counsellors.</p>
            </div>
            <a href="/#contact" class="btn btn-white btn-block">Apply Now <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Hero */
  .uni-hero {
    margin-top: 76px;
    background: var(--navy);
    padding: 60px 0;
    position: relative;
  }
  .uni-hero-content {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .uni-logo-box {
    background: var(--white);
    padding: 16px;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }
  .uni-logo {
    height: 80px;
    width: auto;
    display: block;
  }
  .uni-badge {
    display: inline-block;
    background: rgba(255,255,255,.1);
    color: var(--white);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 6px 12px;
    border-radius: 20px;
    margin-bottom: 12px;
  }
  .uni-title {
    font-family: var(--font-serif);
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 8px;
    line-height: 1.1;
  }
  .uni-location {
    font-size: 1.05rem;
    color: rgba(255,255,255,.8);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Grid Layout */
  .uni-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 40px;
    align-items: start;
  }

  /* Main Content */
  .uni-content {
    padding-top: 40px;
  }
  .content-block { margin-bottom: 48px; }
  
  /* Recognitions Bar */
  .recognitions-bar {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    background: var(--off-white);
    padding: 24px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    margin-bottom: 40px;
  }
  .rec-item {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 1;
    min-width: 200px;
  }
  .rec-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    font-weight: 800;
    font-size: 0.9rem;
    text-align: center;
    line-height: 1.1;
    flex-shrink: 0;
  }
  .naac-badge { background: #fef08a; color: #854d0e; border: 2px solid #fde047; }
  .nirf-badge { background: #e0e7ff; color: #3730a3; border: 2px solid #c7d2fe; }
  .nba-badge { background: #dcfce7; color: #166534; border: 2px solid #bbf7d0; }

  .rec-title {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2px;
  }
  .rec-grade {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--navy);
  }

  .uni-main h2 {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    color: var(--navy);
    margin-bottom: 16px;
  }
  .uni-main p {
    font-size: 1rem;
    color: var(--text-mid);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  /* Recruiters Grid */
  .recruiters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 16px;
  }
  .recruiter-logo {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 16px;
    text-align: center;
    font-weight: 700;
    color: var(--navy-mid);
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 64px;
  }

  /* Courses Grid */
  .courses-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .course-card {
    background: var(--white);
    padding: 20px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
  }
  .cc-icon {
    color: var(--crimson);
    margin-bottom: 12px;
    background: rgba(200,16,46,.08);
    width: 40px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 8px;
  }
  .course-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 6px;
  }
  .course-card p {
    font-size: 0.9rem;
    color: var(--text-mid);
    margin-bottom: 0;
    line-height: 1.4;
  }

  /* Sidebar */
  .uni-sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Fix for placement box background override issue */
  .stats-box {
    background: var(--off-white);
    padding: 28px;
    border-radius: var(--radius-md);
    border-top: 4px solid var(--navy);
  }
  .stats-box.placement-box {
    background: var(--navy) !important;
    color: var(--white) !important;
    border-top: none !important;
    text-align: center;
  }
  
  .pb-icon {
    width: 54px; height: 54px;
    background: rgba(255,255,255,.1);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 12px;
    color: #4ade80;
  }
  .placement-box h4 {
    font-size: 1rem; color: rgba(255,255,255,.8); font-weight: 500; margin-bottom: 6px;
  }
  .pb-amount {
    font-size: 2.5rem; font-weight: 800; font-family: var(--font-serif);
    line-height: 1; margin-bottom: 8px; color: #fff;
  }
  .pb-amount span { font-size: 1rem; opacity: 0.8; font-weight: 500; }
  .placement-box p { font-size: 0.9rem; color: #a5b4fc; margin: 0; }

  .stats-box h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 20px;
  }
  .stats-list {
    list-style: none;
    padding: 0; margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .stats-list li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .stat-icon {
    width: 36px; height: 36px;
    background: var(--white);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: var(--navy-mid);
    box-shadow: var(--shadow-sm);
    flex-shrink: 0;
  }
  .stat-label {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 2px;
  }
  .stat-value {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy);
  }

  .apply-box {
    background: var(--crimson);
    padding: 28px;
    border-radius: var(--radius-md);
    color: var(--white);
    text-align: center;
  }
  .apply-header h3 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    margin-bottom: 10px;
    color: var(--white);
  }
  .apply-header p {
    font-size: 0.9rem;
    color: rgba(255,255,255,.9);
    line-height: 1.5;
    margin-bottom: 20px;
  }
  .btn-white {
    background: var(--white);
    color: var(--crimson);
  }
  .btn-white:hover {
    background: var(--off-white);
  }
  .btn-block {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .uni-grid { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 768px) {
    .uni-hero { padding: 40px 0; }
    .uni-hero-content { flex-direction: column; text-align: center; gap: 20px; }
    .uni-title { font-size: 2rem; }
    .uni-location { justify-content: center; }
    .courses-grid { grid-template-columns: 1fr; }
    .recognitions-bar { flex-direction: column; gap: 16px; padding: 16px; }
    .rec-item { width: 100%; }
    .recruiters-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
