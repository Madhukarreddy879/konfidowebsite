---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout>
  <Navbar />
  
  <div class="uni-header">
    <div class="container">
      <div class="uni-title-wrap">
        <img src="/logos/marwadi.png" alt="Marwadi University Logo" class="uni-logo" />
        <div>
          <h1 class="uni-title">Marwadi University</h1>
          <p class="uni-location">Rajkot, Gujarat</p>
        </div>
      </div>
    </div>
  </div>

  <section class="section uni-content">
    <div class="container">
      <div class="uni-grid">
        <!-- Left: About & Courses -->
        <div class="uni-main">
          <h2>About Marwadi University</h2>
          <p>
            Marwadi University (MU) is a premier higher education institution located in Rajkot, Gujarat. 
            Renowned for its state-of-the-art campus and innovative teaching methodologies, MU offers a diverse range of undergraduate, postgraduate, and doctoral programs. It is committed to fostering academic excellence, research, and holistic development.
          </p>
          
          <h2 style="margin-top: 40px;">Courses Offered</h2>
          <div class="courses-grid">
            <div class="course-card">
              <h3>Engineering (B.Tech / M.Tech)</h3>
              <p>Computer Science, Mechanical, Civil, IT, AI & Data Science.</p>
            </div>
            <div class="course-card">
              <h3>Management (BBA / MBA)</h3>
              <p>Finance, Marketing, HR, Business Analytics, International Business.</p>
            </div>
            <div class="course-card">
              <h3>Computer Applications (BCA / MCA)</h3>
              <p>Software Development, Cloud Computing, Cyber Security.</p>
            </div>
            <div class="course-card">
              <h3>Law & Science</h3>
              <p>BA LLB, B.Sc, M.Sc in various specialized disciplines.</p>
            </div>
          </div>
        </div>

        <!-- Right: Stats & Apply -->
        <div class="uni-sidebar">
          <div class="stats-box">
            <h3>Quick Facts</h3>
            <ul>
              <li><strong>NAAC Grade:</strong> A+</li>
              <li><strong>Campus:</strong> 32+ Acres</li>
              <li><strong>Placement Rate:</strong> 90%+</li>
              <li><strong>Highest Package:</strong> 34.5 LPA</li>
            </ul>
          </div>

          <div class="apply-box">
            <h3>Interested in Marwadi?</h3>
            <p>Get expert guidance on the application process, scholarships, and fee structure.</p>
            <a href="/#contact" class="btn btn-primary" style="width: 100%; justify-content: center;">Apply Now</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .uni-header {
    margin-top: 76px; /* navbar height */
    background: var(--navy);
    padding: 60px 0;
    color: var(--white);
    border-bottom: 4px solid var(--crimson);
  }
  .uni-title-wrap {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .uni-logo {
    background: var(--white);
    padding: 12px;
    border-radius: var(--radius-md);
    height: 90px;
    width: auto;
    object-fit: contain;
  }
  .uni-title {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .uni-location {
    font-size: 1.1rem;
    color: rgba(255,255,255,.7);
  }

  .uni-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 60px;
    align-items: start;
    padding-top: 40px;
  }

  /* Main Content */
  .uni-main h2 {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    color: var(--navy);
    margin-bottom: 16px;
  }
  .uni-main p {
    font-size: 1rem;
    color: var(--text-mid);
    line-height: 1.8;
  }

  .courses-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 20px;
  }
  .course-card {
    background: var(--off-white);
    padding: 24px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
  }
  .course-card h3 {
    font-size: 1.1rem;
    color: var(--navy);
    margin-bottom: 8px;
  }
  .course-card p {
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  /* Sidebar */
  .stats-box {
    background: var(--off-white);
    padding: 32px;
    border-radius: var(--radius-md);
    border-top: 4px solid var(--navy);
    margin-bottom: 24px;
  }
  .stats-box h3 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--navy);
    margin-bottom: 20px;
  }
  .stats-box ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .stats-box li {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    color: var(--text-dark);
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }
  .stats-box li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .apply-box {
    background: var(--white);
    padding: 32px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
  }
  .apply-box h3 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--crimson);
    margin-bottom: 12px;
  }
  .apply-box p {
    font-size: 0.95rem;
    color: var(--text-mid);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  @media (max-width: 900px) {
    .uni-grid { grid-template-columns: 1fr; gap: 40px; }
    .courses-grid { grid-template-columns: 1fr; }
    .uni-title-wrap { flex-direction: column; text-align: center; }
  }
</style>
