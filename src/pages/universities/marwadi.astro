---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout>
  <Navbar />
  
  <div class="uni-hero">
    <div class="container">
      <div class="uni-hero-grid">
        <!-- Left: University Info -->
        <div class="uni-hero-content">
          <div class="uni-logo-box">
            <img src="/logos/marwadi.webp" alt="Marwadi University" class="uni-logo" width="247" height="80" decoding="async" fetchpriority="high" />
          </div>
          <div class="uni-hero-text">
            <div class="uni-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              Centre of Excellence
            </div>
            <h1 class="uni-title">Marwadi University</h1>
            <p class="uni-location">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Rajkot, Gujarat
            </p>
            <div class="uni-highlights">
              <span class="highlight-item">NAAC A+</span>
              <span class="highlight-item">NIRF Top 150</span>
              <span class="highlight-item">90%+ Placements</span>
            </div>
          </div>
        </div>
        
        <!-- Right: Enquiry Form -->
        <div class="enquiry-box">
          <div class="enquiry-header">
            <h3>Start Your Journey</h3>
            <p>We'll help you get admitted</p>
          </div>
          <form id="enquiryForm" class="enquiry-form">
            <div class="form-group">
              <input type="text" id="name" name="name" required placeholder="Your Name" />
            </div>
            <div class="form-group">
              <input type="email" id="email" name="email" required placeholder="Email Address" />
            </div>
            <div class="form-group">
              <input type="tel" id="phone" name="phone" required placeholder="Phone Number" pattern="[0-9]{10}" />
            </div>
            <button type="submit" class="btn btn-white btn-block">
              Get Free Counselling
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </form>
          <div id="formSuccess" class="form-success" style="display: none;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <h4>Thank You!</h4>
            <p>We'll contact you within 24 hours.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="section uni-content">
    <div class="container">
      
      <!-- Compact Stats Bar -->
      <div class="stats-bar">
        <div class="stat-item">
          <div class="stat-number">₹34.5L</div>
          <div class="stat-text">Highest Package</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">90%+</div>
          <div class="stat-text">Placement Rate</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">500+</div>
          <div class="stat-text">Top Companies</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">32 Acres</div>
          <div class="stat-text">Campus</div>
        </div>
      </div>

      <!-- About Section -->
      <div class="about-section">
        <h2>Why Choose Marwadi University?</h2>
        <p>
          NAAC A+ accredited and recognized as a Centre of Excellence by the Government of Gujarat. 
          With NBA accreditation and NIRF Top 150 ranking, we offer world-class education on a modern 32-acre campus.
        </p>
      </div>

      <!-- Programs Grid -->
      <div class="programs-section">
        <h2>Popular Programs</h2>
        <div class="programs-grid">
          <div class="program-card">
            <div class="program-icon">🎓</div>
            <h3>Engineering</h3>
            <p>B.Tech, M.Tech in CS, AI, Mechanical, Civil</p>
          </div>
          <div class="program-card">
            <div class="program-icon">💼</div>
            <h3>Management</h3>
            <p>BBA, MBA, Business Analytics</p>
          </div>
          <div class="program-card">
            <div class="program-icon">💻</div>
            <h3>IT & Apps</h3>
            <p>BCA, MCA, B.Sc IT</p>
          </div>
          <div class="program-card">
            <div class="program-icon">⚖️</div>
            <h3>Law & Sciences</h3>
            <p>BA LLB, B.Pharma, B.Sc, M.Sc</p>
          </div>
        </div>
      </div>

      <!-- Recruiters -->
      <div class="recruiters-section">
        <h2>Our Recruiters</h2>
        <div class="recruiters-grid">
          <img src="/companylogos/amazon.webp" alt="Amazon" loading="lazy" />
          <img src="/companylogos/google.webp" alt="Google" loading="lazy" />
          <img src="/companylogos/tcs.webp" alt="TCS" loading="lazy" />
          <img src="/companylogos/wipro.webp" alt="Wipro" loading="lazy" />
          <img src="/companylogos/congz.webp" alt="Cognizant" loading="lazy" />
          <img src="/companylogos/adani.webp" alt="Adani" loading="lazy" />
        </div>
      </div>

    </div>
  </section>

  <Footer />

<script>
  // Enquiry Form Handling
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('enquiryForm');
    const successMsg = document.getElementById('formSuccess');
    
    if (form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = 'Submitting...';
        submitBtn.disabled = true;
        
        // Collect form data
        const formData = {
          name: document.getElementById('name').value,
          email: document.getElementById('email').value,
          phone: document.getElementById('phone').value,
          university: 'Marwadi University',
          source: window.location.href,
          submittedAt: new Date().toISOString()
        };
        
        try {
          // For now, log to console and show success
          console.log('Enquiry submitted:', formData);
          
          // Simulate API call delay
          await new Promise(resolve => setTimeout(resolve, 1000));
          
          // Show success message
          form.style.display = 'none';
          successMsg.style.display = 'block';
          
          // Track conversion for digital marketing
          if (typeof gtag !== 'undefined') {
            gtag('event', 'enquiry_submit', {
              'event_category': 'lead',
              'event_label': 'Marwadi University'
            });
          }
          
          // Facebook Pixel tracking (if installed)
          if (typeof fbq !== 'undefined') {
            fbq('track', 'Lead');
          }
          
        } catch (error) {
          console.error('Form submission error:', error);
          alert('Something went wrong. Please try again or contact us directly.');
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
        }
      });
    }
  });
</script>
</Layout>

<style>
  /* Hero with Form */
  .uni-hero {
    margin-top: 76px;
    background: linear-gradient(135deg, #0a192f 0%, #1a2f4a 100%);
    padding: 50px 0;
    position: relative;
  }
  .uni-hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .uni-hero-content {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .uni-logo-box {
    background: var(--white);
    padding: 14px;
    border-radius: 12px;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(0,0,0,.1);
  }
  .uni-logo {
    height: 70px;
    width: auto;
    display: block;
  }
  .uni-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,.12);
    color: #fbbf24;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 12px;
    backdrop-filter: blur(10px);
  }
  .uni-title {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 10px;
    line-height: 1.1;
  }
  .uni-location {
    font-size: 1rem;
    color: rgba(255,255,255,.75);
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 16px;
  }
  .uni-highlights {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .highlight-item {
    background: rgba(255,255,255,.08);
    color: rgba(255,255,255,.9);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,.15);
  }

  /* Enquiry Form in Hero */
  .enquiry-box {
    background: linear-gradient(145deg, #c8102e 0%, #a00d25 100%);
    padding: 28px;
    border-radius: 16px;
    color: var(--white);
    box-shadow: 0 20px 40px rgba(0,0,0,.25);
  }
  .enquiry-header {
    text-align: center;
    margin-bottom: 20px;
  }
  .enquiry-header h3 {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    margin-bottom: 6px;
    color: var(--white);
  }
  .enquiry-header p {
    font-size: 0.9rem;
    color: rgba(255,255,255,.85);
    margin: 0;
  }
  
  /* Enquiry Form Styles */
  .enquiry-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
  }
  .form-group input {
    padding: 13px 16px;
    border: 2px solid rgba(255,255,255,.15);
    border-radius: 8px;
    background: rgba(255,255,255,.08);
    color: var(--white);
    font-size: 0.95rem;
    font-family: var(--font-sans);
    transition: all 0.2s ease;
  }
  .form-group input::placeholder {
    color: rgba(255,255,255,.5);
  }
  .form-group input:focus {
    outline: none;
    border-color: rgba(255,255,255,.4);
    background: rgba(255,255,255,.12);
  }
  
  .btn-white {
    background: var(--white);
    color: var(--crimson);
    border: none;
    padding: 14px 24px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 6px;
    border-radius: 8px;
  }
  .btn-white:hover:not(:disabled) {
    background: #f9fafb;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0,0,0,.2);
  }
  .btn-white:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }
  .btn-block {
    width: 100%;
  }
  
  /* Success Message */
  .form-success {
    text-align: center;
    padding: 24px 16px;
    animation: fadeIn 0.5s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .form-success svg {
    margin: 0 auto 16px;
    display: block;
  }
  .form-success h4 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    margin-bottom: 10px;
    color: var(--white);
  }
  .form-success p {
    font-size: 0.95rem;
    color: rgba(255,255,255,.85);
    margin: 0;
  }

  /* Main Content */
  .uni-content {
    padding: 50px 0;
  }

  /* Stats Bar */
  .stats-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 50px;
    background: var(--off-white);
    padding: 32px 24px;
    border-radius: 12px;
  }
  .stat-item {
    text-align: center;
    padding: 12px;
  }
  .stat-number {
    font-size: 2rem;
    font-weight: 800;
    color: var(--crimson);
    font-family: var(--font-serif);
    margin-bottom: 6px;
  }
  .stat-text {
    font-size: 0.85rem;
    color: var(--text-mid);
    font-weight: 500;
  }

  /* About Section */
  .about-section {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 50px;
  }
  .about-section h2 {
    font-family: var(--font-serif);
    font-size: 2rem;
    color: var(--navy);
    margin-bottom: 16px;
  }
  .about-section p {
    font-size: 1.05rem;
    color: var(--text-mid);
    line-height: 1.7;
  }

  /* Programs Section */
  .programs-section {
    margin-bottom: 50px;
  }
  .programs-section h2 {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    color: var(--navy);
    margin-bottom: 24px;
    text-align: center;
  }
  .programs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .program-card {
    background: var(--white);
    padding: 24px 20px;
    border-radius: 12px;
    border: 2px solid var(--border);
    text-align: center;
    transition: all 0.3s ease;
  }
  .program-card:hover {
    transform: translateY(-4px);
    border-color: var(--crimson);
    box-shadow: 0 8px 20px rgba(0,0,0,.08);
  }
  .program-icon {
    font-size: 2.5rem;
    margin-bottom: 12px;
  }
  .program-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 8px;
  }
  .program-card p {
    font-size: 0.9rem;
    color: var(--text-mid);
    margin: 0;
    line-height: 1.4;
  }

  /* Recruiters Section */
  .recruiters-section {
    text-align: center;
  }
  .recruiters-section h2 {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    color: var(--navy);
    margin-bottom: 24px;
  }
  .recruiters-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 24px;
    align-items: center;
    background: var(--off-white);
    padding: 32px 24px;
    border-radius: 12px;
  }
  .recruiters-grid img {
    height: 50px;
    width: 100%;
    object-fit: contain;
    filter: grayscale(100%) opacity(0.7);
    transition: all 0.3s ease;
  }
  .recruiters-grid img:hover {
    filter: grayscale(0%) opacity(1);
    transform: scale(1.1);
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .uni-hero-grid { 
      grid-template-columns: 1fr; 
      gap: 36px; 
    }
    .uni-hero-content { 
      justify-content: center; 
      text-align: center; 
    }
    .uni-location { 
      justify-content: center; 
    }
    .uni-highlights {
      justify-content: center;
    }
    .enquiry-box { 
      max-width: 420px; 
      margin: 0 auto; 
    }
    .stats-bar {
      grid-template-columns: repeat(2, 1fr);
    }
    .programs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .recruiters-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .uni-hero { 
      padding: 36px 0; 
    }
    .uni-hero-content { 
      flex-direction: column; 
      gap: 16px; 
    }
    .uni-title { 
      font-size: 2rem; 
    }
    .stats-bar {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      padding: 24px 16px;
    }
    .stat-number {
      font-size: 1.5rem;
    }
    .programs-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .recruiters-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 480px) {
    .uni-hero-grid {
      gap: 28px;
    }
    .enquiry-box {
      padding: 24px 20px;
    }
    .stats-bar {
      grid-template-columns: 1fr;
    }
  }
</style>
