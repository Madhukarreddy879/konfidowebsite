---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Contact from '../../components/Contact.astro';
---

<Layout>
  <Navbar />
  
  <div class="uni-hero">
    <div class="container">
      <div class="uni-hero-grid">
        <!-- Left: University Info -->
        <div class="uni-hero-content">
          <div class="uni-logo-box">
            <img src="/logos/amity.webp" alt="Amity University" class="uni-logo" width="247" height="80" decoding="async" fetchpriority="high" />
          </div>
          <div class="uni-hero-text">
            <div class="uni-badge">NAAC A+ · WASC (USA) Accredited · NIRF Top 30</div>
            <h1 class="uni-title">Amity University</h1>
            <p class="uni-location">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Hyderabad
            </p>
          </div>
        </div>
        
        <!-- Right: Enquiry Form -->
        <div class="enquiry-box">
          <div class="enquiry-header">
            <h3>Enquire Now</h3>
            <p>Get expert guidance for Amity University admissions</p>
          </div>
          <form id="enquiryForm" class="enquiry-form">
            <div class="form-group">
              <label for="name">Full Name *</label>
              <input type="text" id="name" name="name" required placeholder="Enter your full name" />
            </div>
            <div class="form-group">
              <label for="email">Email Address *</label>
              <input type="email" id="email" name="email" required placeholder="Enter your email" />
            </div>
            <div class="form-group">
              <label for="phone">Phone Number *</label>
              <input type="tel" id="phone" name="phone" required placeholder="Enter your phone number" pattern="[0-9]{10}" />
            </div>
            <button type="submit" class="btn btn-white btn-block">
              Submit Enquiry
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </form>
          <div id="formSuccess" class="form-success" style="display: none;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <h4>Thank You!</h4>
            <p>Your enquiry has been submitted. Our counsellors will contact you within 24 hours.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="section uni-content">
    <div class="container">
      
      <!-- Recognitions Bar -->
      <div class="recognitions-flex">
        <img src="/accred/naac.webp" alt="NAAC A+ Grade" width="200" height="90" loading="lazy" decoding="async" />
        <img src="/accred/nba.webp" alt="NBA Accreditation" width="200" height="90" loading="lazy" decoding="async" />
        <div class="recognition-text-badge">
          <span class="recog-rank">#30</span>
          <span class="recog-label">NIRF Overall 2024</span>
        </div>
        <div class="recognition-text-badge">
          <span class="recog-rank">WASC</span>
          <span class="recog-label">USA Accredited</span>
        </div>
        <div class="recognition-text-badge">
          <span class="recog-rank">DIAMOND</span>
          <span class="recog-label">QS I-GAUGE Rating</span>
        </div>
      </div>

      <div class="uni-grid">
        <!-- Left Column: About & Courses -->
        <div class="uni-main">
          
          <div class="content-block">
            <h2>About Amity University</h2>
            <p>
              India's first and only university to receive <strong>WASC (USA) accreditation</strong>, Amity University stands as a global powerhouse in higher education. With a <strong>NAAC A+ grade (CGPA 3.47/4.00)</strong> and a consistent <strong>NIRF Top 30</strong> ranking, Amity combines academic rigour with world-class infrastructure.
            </p>
            <p>
              Spread across a 60+ acre Wi-Fi-enabled smart campus in Hyderabad, Amity hosts over 30,000 students across 300+ programs. With 12 Indian campuses and 7 global campuses spanning Dubai, London, Singapore, New York, and beyond, Amity delivers truly international exposure. The university's Innovation Incubator, recognized by DST, Govt. of India, has fostered 200+ startups, while 1,000+ patents and SIRO recognition cement its research credentials.
            </p>
          </div>
          
          <!-- Top Recruiters -->
          <div class="content-block recruiters-section">
            <h2>Top Recruiters</h2>
            <div class="recruiters-flex">
              <img src="/companylogos/amazon.webp" alt="Amazon" width="150" height="70" loading="lazy" decoding="async" />
              <img src="/companylogos/google.webp" alt="Google" width="150" height="70" loading="lazy" decoding="async" />
              <img src="/companylogos/tcs.webp" alt="TCS" width="150" height="70" loading="lazy" decoding="async" />
              <img src="/companylogos/congz.webp" alt="Cognizant" width="150" height="70" loading="lazy" decoding="async" />
              <img src="/companylogos/adani.webp" alt="Adani" width="150" height="70" loading="lazy" decoding="async" />
              <img src="/companylogos/wipro.webp" alt="Wipro" width="150" height="70" loading="lazy" decoding="async" />
            </div>
          </div>

          <div class="content-block">
            <h2>Programs Offered</h2>
            <div class="courses-grid">
              <div class="course-card">
                <div class="cc-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg>
                </div>
                <h3>Engineering & Technology</h3>
                <p>B.Tech in CSE, AI/ML, Data Science, Cybersecurity, ECE, Mechanical, Civil, and Blockchain. NBA-accredited with IBM, Apple & Oracle on-campus labs.</p>
                <a href="#enquiryForm" class="enquire-link">Enquire now &rarr;</a>
              </div>
              <div class="course-card">
                <div class="cc-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                </div>
                <h3>Management & Business</h3>
                <p>MBA and BBA with specializations in Marketing, Finance, Analytics, IB & Entrepreneurship. ACBSP (USA) accredited with 500+ recruiter network.</p>
                <a href="#enquiryForm" class="enquire-link">Enquire now &rarr;</a>
              </div>
              <div class="course-card">
                <div class="cc-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                </div>
                <h3>Computer Applications</h3>
                <p>BCA, MCA, and B.Sc IT with cutting-edge specializations in AI, Cloud Computing, and Full-Stack Development. Industry-aligned curriculum.</p>
                <a href="#enquiryForm" class="enquire-link">Enquire now &rarr;</a>
              </div>
              <div class="course-card">
                <div class="cc-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </div>
                <h3>Law & Legal Studies</h3>
                <p>BA LLB (Hons), BBA LLB (Hons), B.Com LLB (Hons), and LLM. NIRF Law Rank #10 — among India's top private law schools with Supreme Court internships.</p>
                <a href="#enquiryForm" class="enquire-link">Enquire now &rarr;</a>
              </div>
              <div class="course-card">
                <div class="cc-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"></path><path d="M3 7h18"></path><path d="M5 7v9a2 2 0 0 0 2 2h0a2 2 0 0 0 2-2V7"></path><path d="M15 7v9a2 2 0 0 0 2 2h0a2 2 0 0 0 2-2V7"></path></svg>
                </div>
                <h3>Design, Media & Architecture</h3>
                <p>B.Des (Fashion, UX/UI, Product), B.Arch (RIBA-validated), and BA Journalism & Mass Communication with industry studio access.</p>
                <a href="#enquiryForm" class="enquire-link">Enquire now &rarr;</a>
              </div>
              <div class="course-card">
                <div class="cc-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.31"></path><path d="M14 9.3V2"></path><path d="M8.5 2h7"></path><path d="M14 9.3a6.5 6.5 0 1 1-4 0"></path><line x1="5.52" y1="16" x2="18.48" y2="16"></line></svg>
                </div>
                <h3>Biotech, Pharmacy & Sciences</h3>
                <p>B.Tech Biotech, B.Pharm, Pharm.D, B.Sc/M.Sc in Physics, Chemistry & Applied Sciences. Research-driven with funded PhD opportunities.</p>
                <a href="#enquiryForm" class="enquire-link">Enquire now &rarr;</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Stats -->
        <div class="uni-sidebar">
          
          <div class="stats-box placement-box">
            <div class="pb-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            </div>
            <h4>Highest Placement</h4>
            <div class="pb-amount">₹61.75 <span>LPA</span></div>
            <p>Average Package: ₹7-9 LPA</p>
          </div>

          <div class="stats-box">
            <h3>Quick Facts</h3>
            <ul class="stats-list">
              <li>
                <span class="stat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg></span>
                <div>
                  <span class="stat-label">Campus Area</span>
                  <strong class="stat-value">60+ Acres</strong>
                </div>
              </li>
              <li>
                <span class="stat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
                <div>
                  <span class="stat-label">Placement Rate</span>
                  <strong class="stat-value">91-95%</strong>
                </div>
              </li>
              <li>
                <span class="stat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/></svg></span>
                <div>
                  <span class="stat-label">Recruiting Companies</span>
                  <strong class="stat-value">500+ Annually</strong>
                </div>
              </li>
              <li>
                <span class="stat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
                <div>
                  <span class="stat-label">Total Programs</span>
                  <strong class="stat-value">300+ Courses</strong>
                </div>
              </li>
              <li>
                <span class="stat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v3m0 16v3M4.22 4.22l2.12 2.12m11.32 11.32l2.12 2.12M1 12h3m16 0h3M4.22 19.78l2.12-2.12m11.32-11.32l2.12-2.12"/></svg></span>
                <div>
                  <span class="stat-label">Global Campuses</span>
                  <strong class="stat-value">7 Countries</strong>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Contact />

  <Footer />

<script>
  // Enquiry Form Handling with Cloudflare Worker + ZeptoMail
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('enquiryForm');
    const successMsg = document.getElementById('formSuccess');
    
    // Cloudflare Worker URL for lead submissions
    const WORKER_URL = 'https://api.konfido.co.in';
    
    if (form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = 'Submitting...';
        submitBtn.disabled = true;
        
        // Collect form data
        const formData = {
          name: document.getElementById('name').value,
          email: document.getElementById('email').value,
          phone: document.getElementById('phone').value,
          university: 'Amity University',
          source: window.location.href,
          submittedAt: new Date().toISOString()
        };
        
        try {
          // Send to Cloudflare Worker
          const response = await fetch(WORKER_URL, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-API-Key': import.meta.env.PUBLIC_API_KEY,
            },
            body: JSON.stringify(formData)
          });
          
          const result = await response.json();
          
          if (result.success) {
            window.location.href = '/thank-you?source=amity';
            
            // Track conversion for digital marketing
            if (typeof gtag !== 'undefined') {
              gtag('event', 'enquiry_submit', {
                'event_category': 'lead',
                'event_label': 'Amity University'
              });
            }
            
            // Facebook Pixel tracking (if installed)
            if (typeof fbq !== 'undefined') {
              fbq('track', 'Lead');
            }
          } else {
            throw new Error(result.error || 'Submission failed');
          }
          
        } catch (error) {
          console.error('Form submission error:', error);
          alert('Something went wrong. Please try again or contact us directly at info@konfido.co.in');
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
        }
      });
    }
  });
</script>
</Layout>

<style>
  /* Hero with Form - Compact & Professional */
  .uni-hero {
    margin-top: 76px;
    background: var(--navy);
    padding: 32px 0;
    position: relative;
  }
  .uni-hero-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 40px;
    align-items: center;
  }
  .uni-hero-content {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .uni-logo-box {
    background: transparent;
    padding: 0;
    border-radius: 0;
    flex-shrink: 0;
  }
  .uni-logo {
    height: 60px;
    width: auto;
    display: block;
  }
  .uni-hero-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .uni-badge {
    display: inline-block;
    background: rgba(255,255,255,.1);
    color: var(--white);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 4px 10px;
    border-radius: 12px;
    align-self: flex-start;
  }
  .uni-title {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--white);
    margin: 0;
    line-height: 1.15;
  }
  .uni-location {
    font-size: 0.92rem;
    color: rgba(255,255,255,.75);
    display: flex;
    align-items: center;
    gap: 5px;
  }

  /* Enquiry Form in Hero - Compact */
  .enquiry-box {
    background: linear-gradient(145deg, #1a2332 0%, #0f1419 100%);
    padding: 24px;
    border-radius: var(--radius-md);
    color: var(--white);
    box-shadow: 0 12px 32px rgba(0,0,0,.4);
    border: 1px solid rgba(255,255,255,.08);
  }
  .enquiry-header {
    text-align: center;
    margin-bottom: 18px;
  }
  .enquiry-header h3 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    margin-bottom: 4px;
    color: var(--white);
    line-height: 1.2;
  }
  .enquiry-header p {
    font-size: 0.82rem;
    color: rgba(255,255,255,.85);
    line-height: 1.4;
    margin: 0;
  }
  
  /* Enquiry Form Styles - Compact */
  .enquiry-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .form-group label {
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255,255,255,.9);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .form-group input {
    padding: 10px 14px;
    border: 1.5px solid rgba(255,255,255,.2);
    border-radius: var(--radius-sm);
    background: rgba(255,255,255,.1);
    color: var(--white);
    font-size: 0.92rem;
    font-family: var(--font-sans);
    transition: all 0.2s ease;
  }
  .form-group input::placeholder {
    color: rgba(255,255,255,.55);
    font-size: 0.88rem;
  }
  .form-group input:focus {
    outline: none;
    border-color: var(--white);
    background: rgba(255,255,255,.15);
  }
  
  .btn-white {
    background: var(--crimson);
    color: var(--white);
    border: none;
    padding: 11px 20px;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 4px;
    border-radius: var(--radius-sm);
  }
  .btn-white:hover:not(:disabled) {
    background: var(--crimson-dark);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(200,16,46,.4);
  }
  .btn-white:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }
  .btn-block {
    width: 100%;
  }
  
  /* Success Message */
  .form-success {
    text-align: center;
    padding: 24px 16px;
    animation: fadeIn 0.5s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .form-success svg {
    margin: 0 auto 16px;
    display: block;
  }
  .form-success h4 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    margin-bottom: 12px;
    color: var(--white);
  }
  .form-success p {
    font-size: 1rem;
    color: rgba(255,255,255,.9);
    line-height: 1.6;
    margin: 0;
  }

  /* Grid Layout */
  .uni-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 40px;
    align-items: start;
  }

  /* Main Content */
  .uni-content {
    padding-top: 40px;
  }
  .content-block { margin-bottom: 48px; }
  
  /* Recognitions Flex Bar */
  .recognitions-flex {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    background: var(--off-white);
    padding: 32px 16px;
    border-radius: var(--radius-md);
    margin-bottom: 50px;
    justify-content: center;
    align-items: center;
  }
  .recognitions-flex img {
    height: 90px;
    width: 200px;
    object-fit: cover;
    object-position: center;
    mix-blend-mode: multiply;
    transition: transform 0.3s ease;
  }
  .recognitions-flex img:hover {
    transform: scale(1.05);
  }
  .recognition-text-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--white);
    border: 2px solid var(--navy-light);
    border-radius: var(--radius-md);
    padding: 16px 24px;
    min-width: 160px;
    min-height: 90px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .recognition-text-badge:hover {
    transform: scale(1.05);
    box-shadow: 0 6px 20px rgba(13,43,85,.12);
  }
  .recog-rank {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--navy);
    line-height: 1.1;
  }
  .recog-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 4px;
    text-align: center;
  }

  .uni-main h2 {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    color: var(--navy);
    margin-bottom: 20px;
  }
  .uni-main p {
    font-size: 1.05rem;
    color: var(--text-mid);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  /* Recruiters Flex Layout */
  .recruiters-section {
    background: var(--off-white);
    padding: 32px;
    border-radius: var(--radius-md);
    border-left: 4px solid var(--crimson);
  }
  .recruiters-flex {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
    justify-content: center;
  }
  .recruiters-flex img {
    height: 70px;
    width: 150px;
    object-fit: cover;
    object-position: center;
    mix-blend-mode: multiply;
    filter: grayscale(100%) opacity(0.8);
    transition: all 0.3s ease;
  }
  .recruiters-flex img:hover {
    filter: grayscale(0%) opacity(1);
    transform: scale(1.05);
  }

  /* Courses Grid */
  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .course-card {
