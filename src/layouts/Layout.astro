---
import '../styles/global.css';
import FloatingCallBtn from '../components/FloatingCallBtn.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Konfido Education & Training — Reach Enlightenment',
  description = 'Konfido Education & Training PVT is a trusted education consultancy since 2005, guiding students through university admissions and entrance exam preparation across India.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/logo.webp" />

    <link rel="icon" type="image/webp" href="/logo.webp" />
    <title>{title}</title>

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Preload critical logo for LCP -->
    <link rel="preload" href="/logo.webp" as="image" type="image/webp" fetchpriority="high" />
    
    <!-- Inline critical font CSS to prevent render blocking -->
    <style>
      /* Critical font display - prevent FOIT */
      @font-face {
        font-family: 'Playfair Display';
        font-display: swap;
        src: local('Playfair Display');
      }
      @font-face {
        font-family: 'DM Sans';
        font-display: swap;
        src: local('DM Sans');
      }
    </style>
    
    <!-- Async font loading -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    </noscript>
  </head>
  <body>
    <slot />
    <FloatingCallBtn />
  </body>
</html>
