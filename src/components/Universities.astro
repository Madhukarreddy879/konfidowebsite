---
const universities = [
  {
    name: 'Amity University',
    location: 'Noida, Uttar Pradesh',
    tag: 'NAAC A+ · WASC USA',
    logo: '/logos/amity.png',
    logoBg: '#fff',
    link: '/universities/amity'
  },
  {
    name: 'Marwadi University',
    location: 'Rajkot, Gujarat',
    tag: 'NAAC Accredited',
    logo: '/logos/marwadi.png',
    logoBg: '#fff',
    link: '/universities/marwadi'
  },
  {
    name: 'NIMS University',
    location: 'Jaipur, Rajasthan',
    tag: 'UGC Recognised',
    logo: '/logos/nims.png',
    logoBg: '#fff',
    link: '/universities/nims'
  },
  {
    name: 'Suresh Gyan Vihar University',
    location: 'Jaipur, Rajasthan',
    tag: 'NAAC Accredited',
    logo: '/logos/sgvu.png',
    logoBg: '#fff',
    link: '/universities/sgvu'
  },
  {
    name: 'Kalasalingam Academy (KARE)',
    location: 'Tamil Nadu',
    tag: 'NAAC A Grade',
    logo: '/logos/kare.png',
    logoBg: '#fff',
    link: '/universities/kare'
  },
];
---

<section class="section" id="universities">
  <div class="container">
    <div class="section-header fade-up">
      <span class="section-tag">Partner Institutions</span>
      <h2 class="section-title">Our University Network</h2>
      <p class="section-sub">
        We have established partnerships with premier institutions across India,
        ensuring our students gain access to quality education and recognised degrees.
      </p>
    </div>

    <div class="uni-grid">
      {universities.map((uni, i) => (
        <div class={`uni-card fade-up fade-up-d${i + 1}`}>
          <div class="uni-logo-box">
            <img 
              src={uni.logo} 
              alt={`${uni.name} logo`} 
              class="uni-logo-img"
              width={uni.logoW}
              height={uni.logoH}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="uni-info">
            <span class="uni-badge">{uni.tag}</span>
            <h3 class="uni-name">{uni.name}</h3>
            <p class="uni-location">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                <circle cx="12" cy="9" r="2.5"/>
              </svg>
              {uni.location}
            </p>
            <a href={uni.link} class="uni-cta">Learn More →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.section-header { margin-bottom: 56px; }

.uni-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 28px;
}

.uni-card {
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--white);
  transition: transform var(--transition), box-shadow var(--transition);
}
.uni-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-lg);
  border-color: var(--navy-light);
}

.uni-logo-box {
  height: 160px;
  background: #f8f9fc;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 28px;
  overflow: hidden;
}
.uni-logo-img {
  max-height: 100px;
  max-width: 100%;
  width: auto;
  object-fit: contain;
  transition: transform var(--transition);
}
.uni-card:hover .uni-logo-img {
  transform: scale(1.04);
}

.uni-info {
  padding: 22px 24px 26px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.uni-badge {
  display: inline-block;
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--crimson);
  background: rgba(200,16,46,.07);
  padding: 3px 10px;
  border-radius: 20px;
  align-self: flex-start;
}
.uni-name {
  font-size: 1.15rem;
  color: var(--navy);
  font-family: var(--font-serif);
  font-weight: 700;
  line-height: 1.3;
}
.uni-location {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 0.82rem;
  color: var(--text-muted);
}
.uni-cta {
  margin-top: 6px;
  font-size: 0.83rem;
  font-weight: 600;
  color: var(--crimson);
  letter-spacing: 0.02em;
  transition: gap var(--transition), color var(--transition);
}
.uni-cta:hover { color: var(--crimson-dark); }
</style>
