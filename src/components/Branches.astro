---
const branches = [
  { city: "Hyderabad (Khairathabad)", state: "Telangana", address: "House No 6-3569/1-2-1/C, Rockdale Hills, opp Khairathabad RTO, 500082", phone: "95026 44931", phoneRaw: "919502644931" },
  { city: "Hyderabad (Saidabad)", state: "Telangana", address: "Main Rd, opp Sai Nursing Home, Uppar Guda, Madannapet Colony, 500059", phone: "77024 82400", phoneRaw: "917702482400" },
  { city: "Khammam", state: "Telangana", address: "D No:15-12-21, 1st Floor, Opp Krishi Bhavan, VDO's Colony, 507157", phone: "77027 66989", phoneRaw: "917702766989" },
  { city: "Hanamkonda", state: "Telangana", address: "1st Floor, Ananda Nilayam, Beside Siva Subramanyam Hospital, New Kishanpura, 500601", phone: "99084 32153", phoneRaw: "919908432153" },
  { city: "Mancherial", state: "Telangana", address: "H. No 12-297/1, 1st Flr, Bellampally Rd, Beside Sri Nidhi Hospital, 504208", phone: "92814 30815", phoneRaw: "919281430815" },
  { city: "Visakhapatnam", state: "Andhra Pradesh", address: "#48-16-7/20, Flat 203, Sri Sai Paradise Asilmetta, Near RTC Complex, 530003", phone: "93902 06050", phoneRaw: "919390206050" },
  { city: "Rajahmundry", state: "Andhra Pradesh", address: "#79-9-17/1, Tilak Road, Opp Mahalaxmi Departmental Store, Near Don Bosco", phone: "95531 50022", phoneRaw: "919553150022" },
  { city: "Kakinada", state: "Andhra Pradesh", address: "Door No. 2-4-23, Srinagar Colony, 533003", phone: "91002 21079", phoneRaw: "919100221079" },
  { city: "Kurnool", state: "Andhra Pradesh", address: "BV Regent Plaza, Plot No 104, Sampath Nagar, 518003", phone: "90528 15985", phoneRaw: "919052815985" }
];
---

<section class="branches-section" id="branches">
  <div class="branches-bg">
    <div class="map-glow map-glow-1"></div>
    <div class="map-glow map-glow-2"></div>
    <div class="noise-overlay"></div>
  </div>

  <div class="container relative z-10">
    <div class="branches-header">
      <span class="section-tag section-tag-light fade-up">Our Footprint</span>
      <h2 class="section-title text-white fade-up fade-up-d1">9 Branches Across AP & Telangana</h2>
      <p class="branches-sub fade-up fade-up-d2">Expert guidance, always within your reach. Walk into any of our regional centres to speak with a dedicated counsellor today.</p>
    </div>

    <div class="branches-grid">
      {branches.map((branch, index) => (
        <div class="branch-card fade-up" style={`animation-delay: ${index * 100}ms`}>
          <div class="bc-top">
            <div class="bc-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="bc-badge">{branch.state}</div>
          </div>
          
          <h3 class="bc-city">{branch.city}</h3>
          
          <div class="bc-details">
            <p class="bc-address">
              {branch.address}
            </p>
          </div>

          <div class="bc-footer">
            <a href={`tel:+${branch.phoneRaw}`} class="bc-phone">
              <span class="phone-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
              +91 {branch.phone}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .branches-section {
    position: relative;
    padding: 100px 0;
    background: #0a1428; /* Extremely deep navy */
    overflow: hidden;
  }

  /* Abstract map glow background */
  .branches-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .map-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.4;
  }
  .map-glow-1 {
    top: -10%; left: 10%;
    width: 50vw; height: 50vw;
    background: rgba(30, 80, 160, 0.4);
  }
  .map-glow-2 {
    bottom: -20%; right: 5%;
    width: 60vw; height: 60vw;
    background: rgba(200, 16, 46, 0.15); /* Crimson hint */
  }
  .noise-overlay {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
  }

  .branches-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 64px;
  }
  .section-tag-light {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.2);
    color: rgba(255,255,255,0.8);
  }
  .text-white { color: #ffffff !important; }
  .branches-sub {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.6;
    margin-top: 16px;
  }

  /* Glassmorphism Grid */
  .branches-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .branch-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(16px);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }
  .branch-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(135deg, rgba(255,255,255,0.06) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .branch-card:hover {
    transform: translateY(-8px);
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }
  .branch-card:hover::before { opacity: 1; }

  .bc-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
    position: relative; z-index: 1;
  }
  .bc-icon {
    width: 40px; height: 40px;
    background: rgba(200, 16, 46, 0.15); /* Crimson tinted background */
    color: #ff4d6d;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 15px rgba(200, 16, 46, 0.2);
  }
  .bc-badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 20px;
    background: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.6);
  }

  .bc-city {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 12px;
    position: relative; z-index: 1;
  }

  .bc-details {
    flex-grow: 1;
    margin-bottom: 24px;
    position: relative; z-index: 1;
  }
  .bc-address {
    font-size: 0.88rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.6;
    margin: 0;
  }

  .bc-footer {
    padding-top: 20px;
    border-top: 1px solid rgba(255,255,255,0.08);
    position: relative; z-index: 1;
  }
  .bc-phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--white);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s;
  }
  .bc-phone:hover {
    color: #ff4d6d;
  }
  .phone-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px; height: 24px;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
  }

  @media (max-width: 992px) {
    .branches-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 640px) {
    .branches-grid {
      grid-template-columns: 1fr;
    }
    .branches-section {
      padding: 60px 0;
    }
  }
</style>
