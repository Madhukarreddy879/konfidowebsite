---
const footerLinks = [
  {
    heading: 'Company',
    links: ['About Us', 'Our Team', 'Careers', 'Contact'],
  },
  {
    heading: 'Services',
    links: ['Admission Guidance', 'Exam Preparation', 'Counselling', 'Scholarships'],
  },
  {
    heading: 'Universities',
    links: ['Marwadi University', 'NIMS University', 'Suresh Gyan Vihar', 'KARE'],
  },
];
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src="/logo.webp" alt="Konfido Education & Training" width="132" height="52" class="footer-logo" loading="lazy" decoding="async" />
      <p class="footer-tagline">
        Empowering every student to <em>Reach Enlightenment</em> by matching their unique potential with the right academic opportunities since 2005.
      </p>
      <div class="footer-social">
        <a href="https://www.facebook.com/konfidoeducationandtraining" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="https://www.instagram.com/konfidoeducation/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="#" aria-label="LinkedIn" class="social-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
        <a href="#" aria-label="WhatsApp" class="social-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </a>
      </div>
    </div>

    {footerLinks.map(col => (
      <div class="footer-col">
        <h4 class="footer-col-heading">{col.heading}</h4>
        <ul class="footer-col-links">
          {col.links.map(l => <li><a href="#">{l}</a></li>)}
        </ul>
      </div>
    ))}
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© {new Date().getFullYear()} Konfido Education & Training PVT. All rights reserved.</p>
      <div class="footer-legal">
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms-and-conditions">Terms & Conditions</a>
      </div>
    </div>
  </div>
</footer>

<style>
.footer {
  background: var(--text-dark);
  padding-top: 72px;
}

.footer-inner {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 48px;
  padding-bottom: 56px;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.footer-brand {}
.footer-logo { filter: brightness(0) invert(1); opacity: 0.85; margin-bottom: 20px; }
.footer-tagline {
  font-size: 0.84rem;
  color: rgba(255,255,255,.45);
  line-height: 1.75;
  max-width: 280px;
}

.footer-social {
  display: flex;
  gap: 10px;
  margin-top: 24px;
}
.social-icon {
  width: 36px; height: 36px;
  background: rgba(255,255,255,.07);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,.55);
  transition: background var(--transition), color var(--transition);
}
.social-icon:hover {
  background: var(--crimson);
  color: var(--white);
}

.footer-col-heading {
  font-family: var(--font-sans);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,.35);
  margin-bottom: 20px;
}
.footer-col-links { display: flex; flex-direction: column; gap: 10px; }
.footer-col-links a {
  font-size: 0.86rem;
  color: rgba(255,255,255,.55);
  transition: color var(--transition);
}
.footer-col-links a:hover { color: var(--white); }

.footer-bottom {
  padding-block: 20px;
}
.footer-bottom-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.footer-bottom p {
  font-size: 0.78rem;
  color: rgba(255,255,255,.28);
}
.footer-legal {
  display: flex;
  gap: 20px;
}
.footer-legal a {
  font-size: 0.78rem;
  color: rgba(255,255,255,.28);
  transition: color var(--transition);
}
.footer-legal a:hover { color: rgba(255,255,255,.6); }

@media (max-width: 900px) {
  .footer-inner { grid-template-columns: 1fr 1fr; gap: 36px; }
  .footer-brand { grid-column: 1 / -1; }
}
@media (max-width: 500px) {
  .footer-inner { grid-template-columns: 1fr; }
  .footer-bottom-inner { flex-direction: column; text-align: center; }
}
</style>
