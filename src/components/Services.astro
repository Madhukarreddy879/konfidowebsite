---
const services = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M22 10v6M2 10l10-5 10 5-10 5-10-5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
    title: 'University Admission Guidance',
    desc: 'Placeholder — Add details about how Konfido guides students through university application and selection processes.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'Career Counselling',
    desc: 'Placeholder — Detail the one-on-one career counselling sessions to help students choose the right stream and institution.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>`,
    title: 'Scholarship Assistance',
    desc: 'Placeholder — Explain scholarship identification and documentation support services provided to eligible students.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
    title: 'Document Verification',
    desc: 'Placeholder — Outline the end-to-end documentation support and verification services offered to applicants.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.59 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 5.49 5.49l.97-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
    title: 'Post-Admission Support',
    desc: 'Placeholder — Describe the follow-up support provided to students after they secure admission.',
  },
];
---

<section class="section section-alt" id="services">
  <div class="container">
    <div class="section-header fade-up">
      <span class="section-tag">What We Offer</span>
      <h2 class="section-title">Our Services</h2>
      <p class="section-sub">
        Comprehensive guidance at every step of your educational journey —
        from selecting the right course to securing your admission.
      </p>
    </div>

    <div class="services-grid">
      {services.map((s, i) => (
        <div class={`service-card fade-up fade-up-d${(i % 4) + 1}`}>
          <div class="service-icon" set:html={s.icon} />
          <h3 class="service-title">{s.title}</h3>
          <p class="service-desc">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.section-header { margin-bottom: 52px; }

.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 24px;
}

.service-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 32px 28px;
  transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  position: relative;
  overflow: hidden;
}
.service-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 4px; height: 0;
  background: var(--crimson);
  transition: height var(--transition);
  border-radius: 0 0 4px 0;
}
.service-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-md);
  border-color: transparent;
}
.service-card:hover::before { height: 100%; }

.service-icon {
  width: 54px; height: 54px;
  background: rgba(13,43,85,.06);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  color: var(--navy);
  transition: background var(--transition), color var(--transition);
}
.service-card:hover .service-icon {
  background: var(--navy);
  color: var(--white);
}

.service-title {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 10px;
  line-height: 1.3;
}
.service-desc {
  font-size: 0.88rem;
  color: var(--text-mid);
  line-height: 1.75;
}
</style>
